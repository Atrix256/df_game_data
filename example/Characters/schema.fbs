include "../common.fbs";

namespace ExampleData.Characters;

// Enums
enum EyeColor : byte { Brown, Hazel, Blue, Green }
enum Alignment : byte { Good, Neutral, Evil }
enum Class : byte { Warrior, Wizard, Cleric, Druid }

// Root Type
table Character
{
  name: string;
  eye_color:EyeColor = Brown;
  alignment:Alignment = Good;
  class:Class = Warrior;
  location:Vec3;
  max_mp:uint16;
  max_hp:uint16;

  inventory:[string] (link:"Item");
}

root_type Character;
