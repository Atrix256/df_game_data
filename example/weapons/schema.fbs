// Define the namespace for the generated code
namespace MyGame.Sample;
attribute "root_type";

// Enums allow you to restrict values to a predefined set
enum Color : byte { Red = 1, Green, Blue }

// Structs are used for simple, fixed-size data (no optional fields, cannot change)
struct Vec3 {
  x:float;
  y:float;
  z:float;
}

// Tables are the main way to define objects (fields can be optional or evolved later)
table Monster (root_type) {
  pos:Vec3;
  mana:short = 150;        // Default value provided
  hp:short = 100;          // Default value provided
  name:string;
  friendly:bool = false;
  inventory:[ubyte];       // Vector (array) of unsigned bytes
  color:Color = Blue;      // Uses the enum defined above
}
