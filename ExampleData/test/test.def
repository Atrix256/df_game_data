namespace TestData;

#include "test_include.def"

// All types
struct EntryAll
{
    //8 bits
    bool _bool;
    uint8 _uint8;
    sint8 _sint8;

    // 16 bits
    uint16 _uint16;
    sint16 _sint16;

    // 32 bits
    uint32 _uint32;
    sint32 _sint32;

    // 64 bits
    uint64 _uint64;
    sint64 _sint64;

    // floating point
    float _float;
    double _double;

    TestInclude.Color _color;
    TestInclude.Pos _pos;
};

/* All types with default values */
struct EntryDefault
{
    //8 bits
    bool _bool = false;
    uint8 _uint8 = 1;
    sint8 _sint8 = -2;

    // 16 bits
    uint16 _uint16 = 3;
    sint16 _sint16 = -4;

    // 32 bits
    uint32 _uint32 = 5;
    sint32 _sint32 = -6;

    // 64 bits
    uint64 _uint64 = 7;
    sint64 _sint64 = -8;

    // floating point
    float _float = 1e4;
    double _double = 1000.0;

    TestInclude.Color _color = Hazel;
    TestInclude.Pos _pos = {32, 45};
};

// All types in dynamic arrays
struct EntryArrayDynamic
{
    //8 bits
    bool _bool[];
    uint8 _uint8[];
    sint8 _sint8[];

    // 16 bits
    uint16 _uint16[];
    sint16 _sint16[];

    // 32 bits
    uint32 _uint32[];
    sint32 _sint32[];

    // 64 bits
    uint64 _uint64[];
    sint64 _sint64[];

    // floating point
    float _float[];
    double _double[];

    TestInclude.Color _color[];
    TestInclude.Pos _pos[];
};

// All types as static sized arrays
struct EntryArray4
{
    //8 bits
    bool _bool[4];
    uint8 _uint8[4];
    sint8 _sint8[4];

    // 16 bits
    uint16 _uint16[4];
    sint16 _sint16[4];

    // 32 bits
    uint32 _uint32[4];
    sint32 _sint32[4];

    // 64 bits
    uint64 _uint64[4];
    sint64 _sint64[4];

    // floating point
    float _float[4];
    double _double[4];

    TestInclude.Color _color[4];
    TestInclude.Pos _pos[4];
};

struct Entry
{
    EntryAll entries;
    EntryDefault entries_defaults;
    EntryArrayDynamic entries_dynamic_arrays;
    EntryArray4 entries_static_arrays;
}

#root Entry
