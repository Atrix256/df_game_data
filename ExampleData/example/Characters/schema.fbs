include "../common.fbs";

// Enums
enum EyeColor : byte { Brown, Hazel, Blue, Green }
enum Alignment : byte { Good, Neutral, Evil }
enum Class : byte { Warrior, Wizard, Cleric, Druid }

// Root Type
table Character
{
  name: string;
  /// eye color is important!
  eye_color:EyeColor = Brown;
  alignment:Alignment = Good;
  class:Class = Warrior;
  location:Vec3;
  max_mp:uint16;
  max_hp:uint16;
  playable:bool = true;
  favorite_numbers:[uint16];

  /// A list of "Item" table links
  inventory:[string] (link:"Item");
}

root_type Character;
