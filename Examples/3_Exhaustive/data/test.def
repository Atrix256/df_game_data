namespace TestData;

#include "test_include.def"

// All types
struct EntryAll
{
    //8 bits
    bool _bool;
    uint8 _uint8;
    int8 _int8;

    // 16 bits
    uint16 _uint16;
    int16 _int16;

    // 32 bits
    uint32 _uint32;
    int32 _int32;

    // 64 bits
    uint64 _uint64;
    int64 _int64;

    // floating point
    float _float;
    double _double;

    TestInclude::Color _color;
    TestInclude::Pos _pos;
};

/* All types with default values */
struct EntryDefault
{
    //8 bits
    bool _bool = false;
    uint8 _uint8 = 1;
    int8 _int8 = -2;

    // 16 bits
    uint16 _uint16 = 3;
    int16 _int16 = -4;

    // 32 bits
    uint32 _uint32 = 5;
    int32 _int32 = -6;

    // 64 bits
    uint64 _uint64 = 7;
    int64 _int64 = -8;

    // floating point
    float _float = 1e4;
    double _double = 1000.0;

    TestInclude::Color _color = Hazel;
    //TestInclude::Pos _pos = {32, 45};
};

// All types in dynamic arrays
struct EntryArrayDynamic
{
    //8 bits
    bool _bool[];
    uint8 _uint8[];
    int8 _int8[];

    // 16 bits
    uint16 _uint16[];
    int16 _int16[];

    // 32 bits
    uint32 _uint32[];
    int32 _int32[];

    // 64 bits
    uint64 _uint64[];
    int64 _int64[];

    // floating point
    float _float[];
    double _double[];

    TestInclude::Color _color[];
    TestInclude::Pos _pos[];
};

// All types as static sized arrays
struct EntryArray4
{
    //8 bits
    bool _bool[4];
    uint8 _uint8[4];
    int8 _int8[4];

    // 16 bits
    uint16 _uint16[4];
    int16 _int16[4];

    // 32 bits
    uint32 _uint32[4];
    int32 _int32[4];

    // 64 bits
    uint64 _uint64[4];
    int64 _int64[4];

    // floating point
    float _float[4];
    double _double[4];

    TestInclude::Color _color[4];
    TestInclude::Pos _pos[4];
};

struct Entry
{
    EntryAll entries;
    TestData::EntryDefault entries_defaults;
    EntryArrayDynamic entries_dynamic_arrays;
    EntryArray4 entries_static_arrays;
}

#root Entry
