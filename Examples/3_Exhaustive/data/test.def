#include "test_include.def"

// All types
struct EntryAll
{
    //8 bits
    bool _bool;
    uint8 _uint8;
    int8 _sint8;

    // 16 bits
    uint16 _uint16;
    int16 _sint16;

    // 32 bits
    uint32 _uint32;
    int32 _sint32;

    // 64 bits
    uint64 _uint64;
    int64 _sint64;

    // floating point
    float _float;
    double _double;

    TestInclude::Color _color;
    TestInclude::Pos _pos;
};

/* All types with default values */
struct EntryDefault
{
    //8 bits
    bool _bool = true;
    uint8 _uint8 = 1;
    int8 _sint8 = -2;

    // 16 bits
    uint16 _uint16 = 3;
    int16 _sint16 = -4;

    // 32 bits
    uint32 _uint32 = 5;
    int32 _sint32 = -6;

    // 64 bits
    uint64 _uint64 = 7;
    int64 _sint64 = -8;

    // floating point
    float _float = 1e4;
    double _double = 1000.0;

    TestInclude::Color _color = Hazel;
    //TestInclude::Pos _pos = {32, 45};
};

// All types in dynamic arrays
struct EntryArrayDynamic
{
    //8 bits
    bool _bool[];
    uint8 _uint8[];
    int8 _sint8[];

    // 16 bits
    uint16 _uint16[];
    int16 _sint16[];

    // 32 bits
    uint32 _uint32[];
    int32 _sint32[];

    // 64 bits
    uint64 _uint64[];
    int64 _sint64[];

    // floating point
    float _float[];
    double _double[];

    TestInclude::Color _color[];
    TestInclude::Pos _pos[];
};

// All types as static sized arrays
struct EntryArray2
{
    //8 bits
    bool _bool[2];
    uint8 _uint8[2];
    int8 _sint8[2];

    // 16 bits
    uint16 _uint16[2];
    int16 _sint16[2];

    // 32 bits
    uint32 _uint32[2];
    int32 _sint32[2];

    // 64 bits
    uint64 _uint64[2];
    int64 _sint64[2];

    // floating point
    float _float[2];
    double _double[2];

    TestInclude::Color _color[2];
    TestInclude::Pos _pos[2];
};

struct Entry
{
    EntryAll entries;
    TestData::EntryDefault entries_defaults;
    EntryArrayDynamic entries_dynamic_arrays;
    EntryArray2 entries_static_arrays;
}

#root Entry
